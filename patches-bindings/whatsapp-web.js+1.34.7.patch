+// Bindings belong to the Page and survive navigation, including while window is being replaced.
+const exposedFunctions = new WeakMap();
+
+/**
+ * Expose a function to the page if it does not exist
+ *
+ * NOTE:
+ * Rewrite it to 'upsertFunction' after updating Puppeteer to 20.6 or higher
+ * using page.removeExposedFunction
+ * https://pptr.dev/api/puppeteer.page.removeexposedfunction
+ *
+ * @param {object} page - Puppeteer Page instance
+ * @param {string} name
+ * @param {Function} fn
+ */
+async function exposeFunctionIfAbsent(page, name, fn) {
+    let functions = exposedFunctions.get(page);
+    if (!functions) {
+        functions = new Map();
+        exposedFunctions.set(page, functions);
+    }
+    if (functions.has(name)) return functions.get(name);
+
+    const exposure = page.evaluate((name) => {
+        return !!window[name];
+    }, name).then((exist) => {
+        if (!exist) return page.exposeFunction(name, fn);
+    });
+    functions.set(name, exposure);
+    try {
+        await exposure;
+    } catch (error) {
+        functions.delete(name);
+        throw error;
+    }
+}
+
+module.exports = { exposeFunctionIfAbsent };
