generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

enum MovementType {
  SALE
  ENTRY
  ADJUSTMENT
  PRICE_CHANGE
}

enum PendingSaleStatus {
  OPEN
  SOLD
  RETURNED
}

model User {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  role      String   @default("USER")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements      Movement[]
  userSessions   UserSession[]
  searchSessions SearchSession[]
  createdPendingSales  PendingSale[] @relation("PendingSaleCreator")
  assignedPendingSales PendingSale[] @relation("PendingSaleAssignee")

  @@map("users")
}

model Product {
  id          String   @id @default(cuid())
  reference   String
  description String
  imagePath   String?
  stockLocation String?
  stock       Int      @default(0)
  minStock    Int      @default(0)
  cashPrice   Decimal
  creditPrice Decimal
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements Movement[]
  pendingSaleItems PendingSaleItem[]

  @@index([reference])
  @@index([isActive])
  @@unique([reference, description])
  @@map("products")
}

model Movement {
  id            String       @id @default(cuid())
  code          String       @unique
  saleGroupCode String?
  type          MovementType
  productId     String
  userId        String
  quantity      Int?
  previousStock Int?
  newStock      Int?
  unitPrice     Decimal?
  totalValue    Decimal?
  paymentMethod String?
  paymentDetails String?
  invoiceName   String?
  invoiceNumber String?
  isCityHallSale Boolean      @default(false)
  observation   String?
  supplier      String?
  reason        String?
  createdAt     DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([type])
  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@index([saleGroupCode])
  @@index([invoiceNumber])
  @@map("movements")
}

model UserSession {
  id          String   @id @default(cuid())
  userId      String
  chatId      String
  type        String
  step        String
  payloadJson String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, chatId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model SearchSession {
  id          String   @id @default(cuid())
  userId      String
  chatId      String
  resultsJson String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, chatId])
  @@index([expiresAt])
  @@map("search_sessions")
}

model PendingSale {
  id                     String            @id @default(cuid())
  code                   String            @unique
  status                 PendingSaleStatus @default(OPEN)
  createdByUserId        String
  assignedUserId         String
  totalValue             Decimal
  originalTotalValue     Decimal?
  discountPercent        Decimal?
  discountAmount         Decimal?
  completedSaleGroupCode String?
  resolvedAt             DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  createdBy User @relation("PendingSaleCreator", fields: [createdByUserId], references: [id])
  assignedTo User @relation("PendingSaleAssignee", fields: [assignedUserId], references: [id])
  items PendingSaleItem[]

  @@index([status, createdAt])
  @@index([assignedUserId, status])
  @@map("pending_sales")
}

model PendingSaleItem {
  id             String   @id @default(cuid())
  pendingSaleId  String
  position       Int
  productId      String
  reference      String
  description    String
  quantity       Int
  cashPrice      Decimal
  creditPrice    Decimal
  priceType      String
  unitPrice      Decimal
  totalValue     Decimal
  previousStock  Int
  reservedStock  Int
  createdAt      DateTime @default(now())

  pendingSale PendingSale @relation(fields: [pendingSaleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([pendingSaleId, position])
  @@index([productId])
  @@map("pending_sale_items")
}
